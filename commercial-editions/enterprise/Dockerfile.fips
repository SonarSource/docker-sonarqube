# check=skip=InvalidDefaultArgInFrom
ARG SONARQUBE_IMAGE
FROM ${SONARQUBE_IMAGE} AS distribution

FROM registry.access.redhat.com/ubi9/openjdk-25@sha256:164b98409ed54f6a5ebd31d628aed70b8b27613ba2ca5f5540675de0d016ad7c

USER 0
RUN useradd --no-create-home --uid 1000 --gid 0 --home-dir /opt/sonarqube sonarqube
COPY --from=distribution /opt/sonarqube /opt/sonarqube
COPY --chown=root:root --chmod=555 entrypoint.sh /opt/sonarqube/docker/

ENV DOCKER_RUNNING=true \
    SONARQUBE_HOME=/opt/sonarqube \
    HOME=/opt/sonarqube \
    SQ_DATA_DIR=/opt/sonarqube/data \
    SQ_EXTENSIONS_DIR=/opt/sonarqube/extensions \
    SQ_LOGS_DIR=/opt/sonarqube/logs \
    SQ_TEMP_DIR=/opt/sonarqube/temp \
    ES_TMPDIR=/opt/sonarqube/temp \
    SONARQUBE_REQUIRE_FIPS=1

VOLUME ["/opt/sonarqube/data", "/opt/sonarqube/extensions", "/opt/sonarqube/logs", "/opt/sonarqube/temp"]
WORKDIR /opt/sonarqube
EXPOSE 9000
USER sonarqube
STOPSIGNAL SIGINT
ENTRYPOINT ["/opt/sonarqube/docker/entrypoint.sh"]
