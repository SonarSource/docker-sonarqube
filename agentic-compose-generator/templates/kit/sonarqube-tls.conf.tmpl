# TLS proxy for your SonarQube, for an nginx you already run on the SonarQube machine. Include this
# file inside your `http { }` block, copy ../tls/tls.crt and ../tls/tls.key to
# /etc/nginx/sonarqube-tls/, then reload nginx. See ../README.md.
server {
  # nginx before 1.25.1: `listen ${kit_port} ssl http2;` and drop the `http2 on;` line.
  listen ${kit_port} ssl;
  http2 on;
  server_name ${server_name};

  ssl_certificate     /etc/nginx/sonarqube-tls/tls.crt;
  ssl_certificate_key /etc/nginx/sonarqube-tls/tls.key;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  # The remediation agent submits analyses through here: no body size limit.
  client_max_body_size 0;

  location / {
    proxy_pass http://127.0.0.1:${upstream_port};
    proxy_http_version 1.1;

    proxy_set_header Host              $$host;
    proxy_set_header X-Real-IP         $$remote_addr;
    proxy_set_header X-Forwarded-For   $$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $$host;
    proxy_set_header X-Forwarded-Port  $$server_port;
    proxy_set_header Connection        "";

    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}
